# Copy to .env.local for local dev, and set the same two values in the
# Cloudflare Pages dashboard under Settings > Environment variables.
#
# The ANON key is safe in the browser: row level security limits it to
# reading published rows and inserting a submission. Never put the
# service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=paste-the-anon-public-key
